# Copier en .env et compléter. Le fichier .env est ignoré par git.

# ── Génération ───────────────────────────────────────────────────

# « ollama » (local, gratuit) ou « anthropic » (API).
RAG_PROVIDER=ollama

# Requis si RAG_PROVIDER=anthropic. Le SDK accepte aussi un profil
# créé par `ant auth login`, auquel cas cette variable est inutile.
# ANTHROPIC_API_KEY=sk-ant-...

# Modèle local (voir `ollama list`).
RAG_LLM=qwen2.5-coder:7b-instruct-q4_K_M

# Modèle API. claude-sonnet-5 coûte 2,5x moins qu'Opus,
# claude-haiku-4-5 encore 2x moins — mais Haiku est le plus faible
# sur l'orchestration multi-outils, ce qu'un agent demande.
RAG_LLM_API=claude-opus-5

# ── Coûts ────────────────────────────────────────────────────────

# Plafond de dépense par diagnostic, en dollars. L'agent s'arrête et
# rend ce qu'il a plutôt que de continuer à facturer.
RAG_BUDGET_MAX=0.50

# ── Accès au cluster ─────────────────────────────────────────────

# Namespaces autorisés, séparés par des virgules. Vide = tous.
# Restreint aussi bien les appels kubectl que l'aperçu.
# RAG_NAMESPACES=prod,staging

# Délai d'attente d'une commande kubectl, en secondes.
RAG_KUBECTL_TIMEOUT=30

# ── Surveillance ─────────────────────────────────────────────────

# Redémarrages par jour au-delà desquels un pod est jugé instable.
# Le compteur brut est cumulatif sur la vie du pod : 124 redémarrages
# en 108 jours est du bruit de fond, pas un incident.
RAG_SEUIL_PAR_JOUR=2.0

# Redémarrages minimum avant de signaler un CrashLoopBackOff.
RAG_SEUIL_REDEMARRAGES=3

# Délai avant de rediagnostiquer le même problème, en secondes.
RAG_DEDUP_SECONDES=1800

# Durée d'un Pending tolérée avant alerte, en secondes.
RAG_PENDING_TOLERE=300

# ── Recherche ────────────────────────────────────────────────────

# Nombre de chunks envoyés au modèle. Mesuré : 3 → 5 fait passer le
# Hit Rate de 91 % à 97 %. Au-delà, aucun gain.
RAG_TOP_K=5
